    "element-plus": "^2.11.4",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.1.1"
  }
}
