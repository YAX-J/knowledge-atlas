{"id": "public-006", "category": "direct_fact", "question": "PetClinic 新建 Visit 时，默认日期是今天还是明天？", "answerable": true, "valid_at": null, "gold_answer": "构造器使用 LocalDate.now().plusDays(1)，默认为明天。", "required_facts": ["明天"], "gold_evidence": [{"source": "corpus/petclinic/Visit.java", "start_line": 51, "end_line": 51, "quote": "\t\tthis.date = LocalDate.now().plusDays(1);"}], "expected_entities": ["petclinic.Visit.date"], "expected_relations": []}
{"id": "public-007", "category": "direct_fact", "question": "PetClinic Visit.description 有哪些非空和长度约束？", "answerable": true, "valid_at": null, "gold_answer": "使用 @NotBlank，并由 @Size(max = 255) 限制长度。", "required_facts": ["NotBlank", "255"], "gold_evidence": [{"source": "corpus/petclinic/Visit.java", "start_line": 43, "end_line": 43, "quote": "\t@NotBlank"}, {"source": "corpus/petclinic/Visit.java", "start_line": 44, "end_line": 44, "quote": "\t@Size(max = 255)"}], "expected_entities": ["petclinic.Visit.description"], "expected_relations": []}
