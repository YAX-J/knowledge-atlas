APP_NAME=Knowledge Atlas API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://knowledge_atlas:knowledge_atlas@localhost:5432/knowledge_atlas
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_BYTES=10485760
TASK_LEASE_SECONDS=300
TASK_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=120
EXTRACTION_MAX_INPUT_CHARS=60000
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_GRAPHQL_URL=https://api.github.com/graphql
GITHUB_API_VERSION=2026-03-10
GITHUB_TIMEOUT_SECONDS=30

GITHUB_IMPORT_MAX_FILES=50

# Offline Jev judging; no calls without an explicit evaluation command
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_TIMEOUT_SECONDS=60

# Offline judge selection: jev or cloudflare; no calls during preflight
EVALUATION_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/cloudflare/clef-flash
# decision: Clef/Clef-flash; chat: text models supporting messages + JSON schema
CLOUDFLARE_JUDGE_MODE=decision
CLOUDFLARE_TIMEOUT_SECONDS=60
CLOUDFLARE_MAX_TOKENS=2048
